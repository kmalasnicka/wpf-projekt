<Window
    x:Class="AutomatonEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Automaton Editor"
    Width="800"
    Height="600">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,5,0" BorderThickness="1" BorderBrush="Black">
            <Grid x:Name="DrawingArea" Background="White" MouseLeftButtonDown="Canvas_MouseLeftButtonDown">
                <!--element do bindowania wlasciwosci aktywnego stanu w panelu State properties-->
                    <ListBox x:Name="StatesPropertiesPanel" ItemsSource="{Binding States}" SelectedItem="{Binding ElementName=TransitionsList, Path=Tag}" Visibility="Collapsed"/>
                <!--dla kazdego transition rysujemy jeden element-->
                    <ItemsControl ItemsSource="{Binding Transitions}"> 
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas MouseLeftButtonDown="Transition_MouseLeftButtonDown">
                                <Path Data="{Binding PathData}">
                                    <!--linia albo krzywa przejscia-->
                                        <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Stroke" Value="Black"/>
                                            <Setter Property="StrokeThickness" Value="2"/>
                                            <Style.Triggers>
                                                <!--jesli jest self loop to zwykly path jest ukryty-->
                                                    <DataTrigger Binding="{Binding IsLoop}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <!--jesli transition jest klikniety to robi sie czerwony -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="Red"/>
                                                    <Setter Property="StrokeThickness" Value="4"/>
                                                </DataTrigger>
                                                <!--jesli transition jest wykonywany w trakcie symulacji to robi sie pomaranczowy-->
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Stroke" Value="OrangeRed"/>
                                                    <Setter Property="StrokeThickness" Value="4"/>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!--rysowanie grota-->
                                <Path Data="{Binding ArrowData}" Fill="Black" Stroke="Black">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoop}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Fill" Value="Red"/>
                                                    <Setter Property="Stroke" Value="Red"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Fill" Value="OrangeRed"/>
                                                    <Setter Property="Stroke" Value="OrangeRed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <!--elipsa dla self loop-->
                                    <Ellipse Width="30" Height="30" Canvas.Left="{Binding LoopX}" Canvas.Top="{Binding LoopY}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Stroke" Value="Black"/>
                                            <Setter Property="StrokeThickness" Value="2"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoop}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="Red"/>
                                                    <Setter Property="StrokeThickness" Value="4"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Stroke" Value="OrangeRed"/>
                                                    <Setter Property="StrokeThickness" Value="4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!--label dla przejscia-->
                                    <TextBlock Text="{Binding DisplayLabel}" Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"  Background="White" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Foreground" Value="OrangeRed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                </TextBlock>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding States}">  <!--dla każdego elementu z kolekcji States narysuj jeden stan-->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--grid pojedynczego stanu-->
                                <Grid Width="{Binding Diameter}" Height="{Binding Diameter}"
                               MouseLeftButtonDown="State_MouseLeftButtonDown"
                               MouseRightButtonDown="State_MouseRightButtonDown"
                               MouseRightButtonUp="State_MouseRightButtonUp"
                               MouseMove="State_MouseMove">
                                <!--context menu stanu, co sie dzieje jak klikniemy prawym przyciskiem-->
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Mark as accepting" Click="MarkAsAccepting_Click"/>
                                        <MenuItem Header="Mark as initial" Click="MarkAsInitial_Click"/>
                                        <MenuItem Header="Delete state" Click="DeleteState_Click"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <!--glowne kolko stanu-->
                                <Ellipse Fill="{Binding FillColor}" Stroke="{Binding EdgeColor}" StrokeThickness="{Binding EdgeThickness}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Stroke" Value="Red"/>
                                                    <Setter Property="StrokeThickness" Value="4"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Stroke" Value="Orange"/>
                                                    <Setter Property="StrokeThickness" Value="5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    </Ellipse>
                                <!--ukryta elipsa ale sie pokazuje gdy stan jest klikniety i sprawia ze ma czerwone obramowanie-->
                                <Ellipse Fill="Transparent" Stroke="Red" StrokeThickness="4">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!--pomaranczowe zaznaczenie stanu na runtime-->
                                <Ellipse Fill="Transparent" Stroke="Orange" StrokeThickness="5">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!--podwojne kolko dla accepting state-->
                                    <Ellipse Margin="6" Stroke="Black" StrokeThickness="2" Fill="Transparent">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAccepting}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <!--strzalka dla initial state-->
                                <TextBlock Text="→" FontSize="24" FontWeight="Bold" Margin="-25,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInitial}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!--nazwa stanu-->
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <!--prawy panel, scrollview-->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--manage states z przyciskami-->
                <GroupBox x:Name="ManageStatesBox" Header="Manage states" FontWeight="Bold" Margin="0,0,0,8">
                <StackPanel>
                    <Button Content="Add state" Click="AddState_Click" Margin="5" Padding="5"/>
                    <Button Content="Import" Click="Import_Click" Margin="5" Padding="5"/>
                    <Button Content="Export JSON" Click="ExportJson_Click" Margin="5" Padding="5"/>
                    <Button Content="Export PNG" Click="ExportImage_Click" Margin="5" Padding="5"/>
                </StackPanel>
            </GroupBox>

                <GroupBox x:Name="ManageTransitionsBox" Header="Manage transitions" FontWeight="Bold" Margin="0,0,0,8">
                    <StackPanel>
                    <TextBlock Text="Transitions from selected state:" Margin="5"/>
                        <!--lista checkboxow-->
                        <ListBox x:Name="TransitionsList" Margin="5">
                        <ListBox.ItemTemplate>
                                <!--dla kazdego stanu pokazujemy checkbox: zaznaczenie checkboxa dodaje przejście, odznaczenie usuwa, loaded ustawua czy checkbox ma byc zaznaczny-->
                                <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                  Checked="Transition_Checked"
                                  Unchecked="Transition_Unchecked"
                                  Loaded="TransitionCheckBox_Loaded"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                        <Button Content="Delete transition" Click="DeleteActiveTransition_Click" Margin="5" Padding="5"/>
                        <!--label transition-->
                            <TextBlock Text="Transition label:" Margin="5"/>
                    <TextBox x:Name="TransitionLabelTextBox" Margin="5" Text="a"/>
                        <!--alfabet-->
                        <TextBlock Text="Alphabet:" Margin="5,10,5,0"/>
                    <TextBlock x:Name="AlphabetTextBlock" Margin="5" FontWeight="Normal"/>
                </StackPanel>
            </GroupBox>
                <!--zmienianie wygladu statesow-->
                <GroupBox x:Name="StatePropertiesBox" Header="State properties" FontWeight="Bold">
                    <StackPanel Margin="5">
                        <TextBlock Text="Fill color"/>
                        <ComboBox SelectedValuePath="Content"
                      SelectedValue="{Binding SelectedItem.FillColor, ElementName=StatesPropertiesPanel, Mode=TwoWay}">
                            <ComboBoxItem Content="White"/>
                            <ComboBoxItem Content="LightBlue"/>
                            <ComboBoxItem Content="LightGreen"/>
                            <ComboBoxItem Content="LightPink"/>
                            <ComboBoxItem Content="Yellow"/>
                        </ComboBox>

                        <TextBlock Text="Edge color" Margin="0,8,0,0"/>
                        <ComboBox SelectedValuePath="Content"
                      SelectedValue="{Binding SelectedItem.EdgeColor, ElementName=StatesPropertiesPanel, Mode=TwoWay}">
                            <ComboBoxItem Content="Black"/>
                            <ComboBoxItem Content="Red"/>
                            <ComboBoxItem Content="Blue"/>
                            <ComboBoxItem Content="Green"/>
                            <ComboBoxItem Content="Purple"/>
                        </ComboBox>

                        <TextBlock Text="Radius" Margin="0,8,0,0"/>
                        <Slider Minimum="15" Maximum="50"
                    Value="{Binding SelectedItem.Radius, ElementName=StatesPropertiesPanel, Mode=TwoWay}"/>

                        <TextBlock Text="Edge thickness" Margin="0,8,0,0"/>
                        <Slider Minimum="1" Maximum="8"
                    Value="{Binding SelectedItem.EdgeThickness, ElementName=StatesPropertiesPanel, Mode=TwoWay}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Runtime" FontWeight="Bold" Margin="0,8,0,0">
                    <StackPanel Margin="5">
                        <!--slowo wejsciowe-->
                        <TextBlock Text="Input word:"/>
                        <TextBox x:Name="InputWordTextBox" Margin="0,4,0,4" TextChanged="InputWordTextBox_TextChanged"/>
                        <Button Content="Start computation" Click="StartComputation_Click" Margin="0,4,0,4" Padding="5"/>
                        <Button x:Name="PreviousButton" Content="Previous" Click="PreviousStep_Click" Margin="0,4,0,4" Padding="5" IsEnabled="False"/>
                        <Button x:Name="NextButton" Content="Next" Click="NextStep_Click" Margin="0,4,0,4" Padding="5" IsEnabled="False"/>
                        <Button Content="Reset computation" Click="ResetComputation_Click" Margin="0,4,0,4" Padding="5"/>

                        <TextBlock Text="Animation:" Margin="0,10,0,4"/>

                        <Button x:Name="StartAnimationButton" Content="Start animation" Click="StartAnimation_Click" Margin="0,4,0,4" Padding="5" IsEnabled="False"/>
                        <Button x:Name="StopAnimationButton" Content="Stop animation" Click="StopAnimation_Click" Margin="0,4,0,4" Padding="5" IsEnabled="False"/>
                        <Button x:Name="ResetAnimationButton" Content="Reset animation" Click="ResetAnimation_Click" Margin="0,4,0,4" Padding="5" IsEnabled="False"/>
                        <!--slider zmienia szybkosc animacji-->
                        <TextBlock Text="Animation speed:" Margin="0,8,0,0"/>
                        <Slider x:Name="AnimationSpeedSlider" Minimum="200" Maximum="2000" Value="1000" ValueChanged="AnimationSpeedSlider_ValueChanged"/>
                        <TextBlock Text="Lower value = faster" FontWeight="Normal" FontSize="10"/>
                        <!--komunikaty-->
                        <TextBlock x:Name="InputValidationTextBlock" FontWeight="Normal" TextWrapping="Wrap" Margin="0,4,0,4"/>
                        <TextBlock Text="Processed word:" Margin="0,8,0,4"/>

                        <ItemsControl x:Name="InputLettersItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Black" BorderThickness="1" Padding="6" Margin="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="Yellow"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding Symbol}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!--tabela historii computation-->
                        <TextBlock Text="State history:" Margin="0,10,0,4"/>
                        <ListView x:Name="HistoryList" Height="120">
                            <ListView.View>
                                <GridView>
                                    <!--kolumny state i letter-->
                                    <GridViewColumn Header="State" DisplayMemberBinding="{Binding StateName}" Width="60"/>
                                    <GridViewColumn Header="Letter" DisplayMemberBinding="{Binding Letter}" Width="60"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>